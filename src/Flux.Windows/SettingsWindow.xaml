<Window x:Class="Flux.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Flux Settings" Width="680" Height="740" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" Foreground="#F4F6FA"
        Loaded="Window_Loaded" Opacity="0">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="44" />
            <Setter Property="Background" Value="#10FFFFFF" />
            <Setter Property="Foreground" Value="#F4F6FA" />
            <Setter Property="CaretBrush" Value="#FFFFFF" />
            <Setter Property="SelectionBrush" Value="#6F5EF9" />
            <Setter Property="BorderBrush" Value="#28FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="Margin" Value="0,6,0,16" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="FieldBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FieldBorder" Property="BorderBrush" Value="#9C8FFF" />
                                <Setter TargetName="FieldBorder" Property="Background" Value="#18FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="FieldBorder" Property="Opacity" Value="0.38" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#F4F6FA" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemSurface" Background="Transparent" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="#20FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="#2A8B7CFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="44" />
            <Setter Property="Background" Value="#10FFFFFF" />
            <Setter Property="Foreground" Value="#F4F6FA" />
            <Setter Property="BorderBrush" Value="#28FFFFFF" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="Margin" Value="0,6,0,16" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropDownToggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ComboSurface" Background="#10FFFFFF" BorderBrush="#28FFFFFF"
                                                BorderThickness="1" CornerRadius="12">
                                            <Grid>
                                                <ContentPresenter x:Name="ContentSite" Margin="13,0,38,0"
                                                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplateSelector="{Binding ItemTemplateSelector, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                                <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0"
                                                      Fill="#AAB0BC" Data="M 0 0 L 4 4 L 8 0 Z" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ComboSurface" Property="BorderBrush" Value="#55FFFFFF" />
                                                <Setter TargetName="ComboSurface" Property="Background" Value="#16FFFFFF" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ComboSurface" Property="BorderBrush" Value="#9C8FFF" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <TextBox x:Name="PART_EditableTextBox" Style="{x:Null}" Visibility="Hidden"
                                     Height="42" Margin="13,1,38,1" Background="Transparent" BorderThickness="0"
                                     Foreground="#F4F6FA" CaretBrush="#FFFFFF" VerticalContentAlignment="Center" />

                            <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border MinWidth="{TemplateBinding ActualWidth}" MaxHeight="260" Margin="0,6,0,0"
                                        Padding="5" Background="#FC090909" BorderBrush="#38FFFFFF"
                                        BorderThickness="1" CornerRadius="13">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="12" ShadowDepth="3" Opacity="0.48" />
                                    </Border.Effect>
                                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.38" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F4F6FA" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="CheckSurface" Width="20" Height="20" CornerRadius="6"
                                    Background="#10FFFFFF" BorderBrush="#38FFFFFF" BorderThickness="1">
                                <TextBlock x:Name="CheckMark" Text="✓" Foreground="#FFFFFF" FontSize="13"
                                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckSurface" Property="BorderBrush" Value="#8B7CFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckSurface" Property="Background" Value="#6F5EF9" />
                                <Setter TargetName="CheckSurface" Property="BorderBrush" Value="#9C91FF" />
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowIconButton" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="#8B929E" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseSurface" Background="Transparent" CornerRadius="21">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter TargetName="CloseSurface" Property="Background" Value="#18FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border x:Name="SettingsShell" Margin="18" Background="#F00A0A0A"
                BorderBrush="#30FFFFFF" BorderThickness="1" CornerRadius="26"
                RenderTransformOrigin="0.5,0.5">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="17" ShadowDepth="3" Opacity="0.5" />
            </Border.Effect>
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="SettingsScale" />
                    <TranslateTransform x:Name="SettingsTranslate" />
                </TransformGroup>
            </Border.RenderTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="88" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="82" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="26,0,20,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="74" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Width="58" Height="40" Source="Assets/FluxMark.png" Stretch="Uniform"
                           HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Settings" FontSize="23" FontWeight="SemiBold" />
                        <TextBlock Text="Local-first, fast and private" Foreground="#7F8794" FontSize="12" Margin="0,4,0,0" />
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource WindowIconButton}" ToolTip="Close"
                            Click="Close_Click" AutomationProperties.Name="Close settings">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1" Margin="26,0,18,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,8,0">
                        <Border Background="#0CFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1"
                                CornerRadius="18" Padding="20" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="LOCAL INTELLIGENCE" Foreground="#9C91FF" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock Text="AI routing" FontSize="18" FontWeight="SemiBold" Margin="0,7,0,2" />
                                <TextBlock Text="Deterministic searches remain instant and never call a model."
                                           Foreground="#808895" FontSize="12" Margin="0,0,0,16" />

                                <TextBlock Text="Mode" Foreground="#BEC3CC" />
                                <ComboBox x:Name="ModeBox" SelectionChanged="ModeBox_SelectionChanged" />

                                <TextBlock Text="Local endpoint" Foreground="#BEC3CC" />
                                <TextBox x:Name="LocalEndpointBox" />

                                <TextBlock Text="Fast local model" Foreground="#BEC3CC" />
                                <ComboBox x:Name="LocalModelBox" IsEditable="True" />

                                <TextBlock Text="Larger local model" Foreground="#BEC3CC" />
                                <ComboBox x:Name="LocalLargeModelBox" IsEditable="True" />
                                <TextBlock Text="The fast model can hand complex requests to this model."
                                           Foreground="#777E8C" FontSize="12" TextWrapping="Wrap" Margin="0,-7,0,4" />

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Test local connection" Click="TestLocal_Click" />
                                    <TextBlock x:Name="LocalStatus" Foreground="#999FAC" VerticalAlignment="Center"
                                               Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="310" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="#0CFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1"
                                CornerRadius="18" Padding="20" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="OPTIONAL CLOUD" Foreground="#777F8C" FontSize="11" FontWeight="SemiBold" />
                                <TextBlock Text="Cloud model" Foreground="#BEC3CC" Margin="0,12,0,0" />
                                <TextBox x:Name="CloudModelBox" />
                                <TextBlock Text="Reads OPENAI_API_KEY from your environment. Flux never saves the key."
                                           Foreground="#777E8C" FontSize="12" TextWrapping="Wrap" Margin="0,-7,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Background="#0CFFFFFF" BorderBrush="#1FFFFFFF" BorderThickness="1"
                                CornerRadius="18" Padding="20" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock Text="BEHAVIOUR" Foreground="#777F8C" FontSize="11" FontWeight="SemiBold" />
                                <CheckBox x:Name="StartupBox" Content="Start Flux with Windows" Margin="0,16,0,12" />
                                <CheckBox x:Name="UpdateCheckBox" Content="Check for updates when Flux launches" Margin="0,0,0,18" />

                                <TextBlock Text="Global shortcut" Foreground="#BEC3CC" />
                                <ComboBox x:Name="HotkeyBox" DisplayMemberPath="Label" />

                                <TextBlock Text="History retention" Foreground="#BEC3CC" />
                                <TextBox x:Name="HistoryLimitBox" Width="120" HorizontalAlignment="Left" />
                                <Button Content="Clear command history" HorizontalAlignment="Left" Click="ClearHistory_Click" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="2" Margin="26,16,26,20">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel" Margin="0,0,9,0" Click="Cancel_Click" />
                        <Button Content="Save changes" Background="#6F5EF9" BorderBrush="#9C91FF" Click="Save_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
