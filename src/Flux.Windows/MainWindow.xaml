<Window x:Class="Flux.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Flux" Width="840" Height="104" MinWidth="700" MaxHeight="660"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True"
        SnapsToDevicePixels="True" Deactivated="Window_Deactivated">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <DropShadowEffect x:Key="CogGlow" Color="#B8AEFF" BlurRadius="15" ShadowDepth="0" Opacity="0.95" />
        <Style x:Key="CogButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="#87909E" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CogSurface" Width="46" Height="46" CornerRadius="23" Background="Transparent">
                            <ContentPresenter x:Name="CogContent" HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RenderTransformOrigin="0.5,0.5">
                                <ContentPresenter.RenderTransform>
                                    <RotateTransform x:Name="CogRotation" />
                                </ContentPresenter.RenderTransform>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter TargetName="CogSurface" Property="Background" Value="#14FFFFFF" />
                                <Setter TargetName="CogSurface" Property="Effect" Value="{StaticResource CogGlow}" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CogRotation" Storyboard.TargetProperty="Angle"
                                                             To="24" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="CogRotation" Storyboard.TargetProperty="Angle"
                                                             To="0" Duration="0:0:0.13">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CogSurface" Property="Background" Value="#25FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="LauncherRoot" RenderTransformOrigin="0.5,0.12">
        <Grid.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="LauncherScale" ScaleX="1" ScaleY="1" />
                <TranslateTransform x:Name="LauncherTranslate" />
            </TransformGroup>
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="96" />
            <RowDefinition Height="10" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border x:Name="SearchPill" Grid.Row="0" Margin="8,8,8,0"
                Background="#DC000000" BorderBrush="#28FFFFFF" BorderThickness="1" CornerRadius="44">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="13" ShadowDepth="2" Opacity="0.46" />
            </Border.Effect>
            <Grid Margin="25,0,17,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="92" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="54" />
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" Width="68" Height="48" Source="Assets/FluxMark.png"
                       Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />

                <Grid Grid.Column="1" Margin="3,0,12,0">
                    <TextBox x:Name="QueryBox" FontFamily="Segoe UI Variable, Segoe UI" FontSize="25"
                             Foreground="#FFFDFD" Background="Transparent" BorderThickness="0"
                             VerticalContentAlignment="Center" CaretBrush="#FFFFFF"
                             SelectionBrush="#7061D9" SelectionOpacity="0.7"
                             TextChanged="QueryBox_TextChanged" KeyDown="QueryBox_KeyDown" />
                    <TextBlock x:Name="Placeholder" Text="Ask Flux anything…"
                               FontFamily="Segoe UI Variable, Segoe UI" FontSize="25"
                               Foreground="#707782" IsHitTestVisible="False" VerticalAlignment="Center" />
                </Grid>

                <Border x:Name="ModelBadge" Grid.Column="2" Visibility="Collapsed"
                        Width="34" Height="34" VerticalAlignment="Center" Margin="4,0,5,0"
                        Background="#1600D9A6" BorderBrush="#3000D9A6" BorderThickness="1" CornerRadius="17">
                    <TextBlock x:Name="ModelBadgeText" Text="↻" Foreground="#9EEBD9"
                               FontFamily="Segoe UI Symbol, Segoe UI" FontSize="17" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <RotateTransform x:Name="ModelBadgeRotation" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                </Border>

                <Button Grid.Column="3" Style="{StaticResource CogButtonStyle}" ToolTip="Settings"
                        Click="Settings_Click" AutomationProperties.Name="Settings">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="21"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                </Button>
            </Grid>
        </Border>

        <Canvas x:Name="ParticleCanvas" Grid.RowSpan="3" Panel.ZIndex="5"
                IsHitTestVisible="False" ClipToBounds="False" />

        <Border x:Name="ResultsSurface" Grid.Row="2" Margin="8,0,8,8"
                Background="#E8000000" BorderBrush="#24FFFFFF" BorderThickness="1"
                CornerRadius="24" Visibility="Collapsed" RenderTransformOrigin="0.5,0">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="16" ShadowDepth="3" Opacity="0.42" />
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform x:Name="ResultsTranslate" />
            </Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <ListBox x:Name="ResultsList" Background="Transparent" BorderThickness="0"
                             Margin="12,10" ScrollViewer.VerticalScrollBarVisibility="Auto"
                             Visibility="Collapsed" MouseDoubleClick="ResultsList_MouseDoubleClick">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,1" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder" Background="{TemplateBinding Background}"
                                                    CornerRadius="13" Padding="16,12">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#20FFFFFF" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#16FFFFFF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="20" Height="20" CornerRadius="6" Background="#22FFFFFF" VerticalAlignment="Center">
                                        <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}" FontSize="15"
                                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource MutedBrush}" FontSize="12"
                                                   Margin="0,3,12,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Kind}" Foreground="#777F8E" FontSize="11"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <ScrollViewer x:Name="StatusPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Margin="30,24">
                        <StackPanel>
                            <TextBlock x:Name="StatusEyebrow" Text="FLUX" Foreground="{StaticResource AccentBrush}"
                                       FontSize="11" FontWeight="SemiBold" />
                            <TextBlock x:Name="StatusTitle" Foreground="{StaticResource TextBrush}" FontSize="19"
                                       FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap" />
                            <TextBlock x:Name="StatusText" Foreground="#C3C8D2" FontSize="14" LineHeight="22"
                                       Margin="0,10,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>

                    <Grid x:Name="BusyPanel" Visibility="Collapsed" Margin="30,24">
                        <StackPanel VerticalAlignment="Center">
                            <ProgressBar IsIndeterminate="True" Height="2" Foreground="{StaticResource AccentBrush}" Background="#24FFFFFF" />
                            <TextBlock x:Name="BusyText" Text="Working locally…" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,0" />
                        </StackPanel>
                    </Grid>

                    <Border x:Name="ConfirmationPanel" Visibility="Collapsed" Margin="20,18" Padding="20"
                            Background="#F00A0A0A" CornerRadius="16" BorderBrush="#34FFFFFF" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="CONFIRM ACTION" Foreground="#FFB86B" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock x:Name="ConfirmationTitle" Foreground="{StaticResource TextBrush}" FontSize="18"
                                       FontWeight="SemiBold" Margin="0,9,0,0" TextWrapping="Wrap" />
                            <TextBlock x:Name="ConfirmationDetails" Foreground="#B8BEC9" FontSize="13" LineHeight="20"
                                       Margin="0,8,0,16" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Cancel" Margin="0,0,8,0" Click="CancelConfirmation_Click" />
                                <Button x:Name="ConfirmButton" Content="Confirm" Background="#6F5EF9" BorderBrush="#8B7CFF"
                                        Click="Confirm_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid x:Name="Footer" Grid.Row="1" Height="42" Margin="24,0" Visibility="Collapsed">
                    <TextBlock Text="↑↓ navigate   ↵ open   esc dismiss" Foreground="#646B78" FontSize="11"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="ModeLabel" Text="DETERMINISTIC" Foreground="#646B78" FontSize="10"
                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
